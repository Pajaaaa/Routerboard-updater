# /etc/default/mikrotik-upgrader
PORT=2820
BASE_PATH=/mikrotik
MTU_PUBLIC_URL=https://example.org/mikrotik
# heslo pro přihlášení do webu
MTU_PASSWORD=zmenit
# klíč pro šifrování hesel routerů v DB (min. 16 znaků, po změně se stará hesla nedají dešifrovat!)
MTU_SECRET=zmenit-dlouhy-nahodny-retezec
# automatický sken verzí (hodiny), 0 = vypnuto
MTU_SCAN_HOURS=6
MTU_SCAN_PARALLEL=4

# Přihlášení přes SSO (OpenID Connect, např. Keycloak). Když je vyplněno, na přihlašovací stránce je tlačítko SSO.
# V SSO založ klienta (confidential) s redirect URI <MTU_PUBLIC_URL>/auth/callback.
SSO_DISCOVERY_URL=https://sso.example.org/realms/realm/.well-known/openid-configuration
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# volitelně: jen tyto e-maily smějí dovnitř (čárkou); prázdné = každý přihlášený v SSO
SSO_ALLOWED_EMAILS=
# správci (čárkou): nastavení, mazání zařízení, zobrazení hesel routerů, dělení oddílů. Prázdné = každý přihlášený je správce.
SSO_ADMIN_EMAILS=
