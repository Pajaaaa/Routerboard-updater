# /etc/default/mikrotik-upgrader
PORT=2820
BASE_PATH=/mikrotik
MTU_PUBLIC_URL=https://example.org/mikrotik
# první správce: založí se při prvním startu (prázdná DB) s tímto jménem a heslem; při přihlašování jen přes SSO se pak nepoužívá
MTU_ADMIN_USER=admin
MTU_PASSWORD=zmenit
# klíč pro šifrování hesel routerů v DB (min. 16 znaků, po změně se stará hesla nedají dešifrovat!)
MTU_SECRET=zmenit-dlouhy-nahodny-retezec
# prefix vlastní sítě jen pro příklady v dialogu skenu (např. 10.20)
MTU_NET_HINT=192.0.2
# zdrojová IP, ze které server chodí na routery přes SSH (ukazuje se všem v UI, aby ji povolili ve firewallu); prázdné = neukazuje se
MTU_SOURCE_IP=
# přihlášení jménem a heslem: yes (výchozí) / local (jen z localhostu, pro údržbu; uživatelé jdou přes SSO) / no
MTU_PASSWORD_LOGIN=yes
# kolik zařízení kontrolovat souběžně (po načtení, před jobem, ručně); plošný periodický sken není
MTU_SCAN_PARALLEL=4

# Přihlášení přes SSO (OpenID Connect, např. Keycloak). Když je vyplněno, na přihlašovací stránce je tlačítko SSO.
# V SSO založ klienta (confidential) s redirect URI <MTU_PUBLIC_URL>/auth/callback.
SSO_DISCOVERY_URL=https://sso.example.org/realms/realm/.well-known/openid-configuration
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# volitelně: jen tyto e-maily smějí dovnitř (čárkou); prázdné = každý přihlášený v SSO
SSO_ALLOWED_EMAILS=
# e-maily, které při prvním SSO přihlášení dostanou roli správce (čárkou); ostatní jsou běžní uživatelé. Roli jde později změnit v Uživatelích.
SSO_ADMIN_EMAILS=

# Napojení na userdb.hkfree.org (evidence oblastí, APček a loginů k zařízením). Bez klíče je funkce vypnutá.
# API klíč vydává správa userdb (uživatel apikeyNN + heslo); potřebné moduly: Areas, Device, Monitoring.
MTU_USERDB_USER=
MTU_USERDB_PASS=
# MTU_USERDB_URL=https://userdb.hkfree.org/userdb/api
# MTU_USERDB_CACHE_MIN=10
